		{"id":"e21","fromNode":"n_hallmotor","fromSide":"bottom","toNode":"n_rod","toSide":"top","label":"符号脉冲增量"},
		{"id":"e22","fromNode":"n_rod","fromSide":"right","toNode":"n_arb","toSide":"bottom","label":"限位驻留每拍 CLEAR_ALLOW / AT_MAX"},
